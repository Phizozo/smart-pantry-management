<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <activity
            android:name=".activity.PantryListActivity"
            android:exported="true"
            android:label="@string/title_pantry_list">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activity.AddEditIngredientActivity" android:exported="false"
            android:label="@string/title_add_edit_ingredient" />
        <activity android:name=".activity.SuggestedRecipesActivity" android:exported="false"
            android:label="@string/title_suggested_recipes" />
        <activity android:name=".activity.RecipeDetailActivity" android:exported="false"
            android:label="@string/title_recipe_detail" />
        <activity android:name=".activity.SettingsActivity" android:exported="false"
            android:label="@string/title_settings" />
    </application>
</manifest>
